# ==============================================================================
# KONFIGURASI SUPABASE & VERCEL UNTUK KMLC
# Salin file ini menjadi .env jika ingin menggunakan database Supabase
# ==============================================================================

# 1. Kredensial Supabase (Dapat dari Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Akun Pengurus CMS Default (Opsional, bawaan: admin@kmlc.id / admin123)
ADMIN_EMAIL=admin@kmlc.id
ADMIN_PASSWORD=admin123
